DATABASE_URL=file:./data/payana.db
UPLOAD_DIR=./data/uploads
UPLOAD_MAX_MB=250
UPLOAD_EXTENSIONS=apk,aab,ipa,exe,msi,dmg,pkg,zip,tar.gz
ACCESS_TOKEN_SECONDS=900
REFRESH_TOKEN_SECONDS=604800
# Generate with npm run setup:env; these must be unique random secrets.
TOKEN_SECRET=
MFA_ENCRYPTION_KEY=
# Optional initial-admin input for npm run admin:create. No default credentials.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_PASSWORD=
# Set true only behind a trusted proxy that overwrites X-Forwarded-Host, X-Forwarded-Proto, and X-Forwarded-For.
TRUST_PROXY=false
# Optional: Set true in local/LAN development to allow login without mandatory TOTP setup.
DISABLE_MFA=true
# Optional: Set true in development to allow mutations from all network IPs.
ALLOW_ALL_ORIGINS=true
